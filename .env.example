# Shared config template for the ML codebase. Copy to ml/.env (git-ignored)
# and fill in real values.

# ACN-Data token used by notebook 01 only (fetch + cache training data)
ACN_DATA_API_KEY=your-acn-token-here

# Dedicated database for the standalone ml/service (NOT the backend's DB).
# On a fresh Postgres server any user with CREATEDB rights works:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/chargepilot_ml
# ...or run fully offline with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///ml_demo.db

JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
